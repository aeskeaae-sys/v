# ---------------------------------------------------------------------------
# FlowMail / RelayBox environment template — placeholders only, no secrets.
# Production startup validation requires the variables marked REQUIRED.
# ---------------------------------------------------------------------------

NODE_ENV="development"
PORT="3000"

# GEMINI_API_KEY: only needed if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: public URL of the hosted applet (injected at runtime in AI Studio).
APP_URL="MY_APP_URL"

# Frontend build-time API base URL. Leave empty when SPA is served by the API origin.
# Example for Vercel SPA + separate backend: VITE_API_BASE_URL="https://api.example.com"
VITE_API_BASE_URL=""

# Comma-separated browser origins allowed for CORS and state-changing requests.
# Required in production when the SPA is hosted on a different origin.
ALLOWED_ORIGINS=""

# ---------------------------------------------------------------------------
# REQUIRED in production
# ---------------------------------------------------------------------------
# Use a random value of at least 32 characters. Store in the platform secret manager.
RELAYBOX_ENCRYPTION_KEY="CHANGE_ME_WITH_A_RANDOM_32_PLUS_CHAR_SECRET"
# Use a random value of at least 12 characters. Cannot be changed from the web UI when set here.
ADMIN_PASSCODE="CHANGE_ME_WITH_A_STRONG_ADMIN_PASSCODE"
# HMAC secret for POST /api/v1/inbound (at least 16 characters).
WEBHOOK_INBOUND_SECRET="CHANGE_ME_WITH_A_RANDOM_WEBHOOK_SECRET"
# Enforce credentials on /api/v1/* in production.
REQUIRE_API_KEY="true"

# ---------------------------------------------------------------------------
# Database / worker
# ---------------------------------------------------------------------------
# Must point to a persistent volume in production. Do not use an ephemeral path.
FLOWMAIL_DB_PATH=".data/mailbox.db"
# Set to "true" only for the dedicated persistent worker service.
WORKER_MODE="false"

# ---------------------------------------------------------------------------
# SMTP — inbound bridge is loopback-only and has no TLS. Terminate TLS at an MTA.
# Do NOT expose SMTP_PORT publicly. Enable authentication if SMTP is used.
# ---------------------------------------------------------------------------
SMTP_ENABLED="false"
SMTP_BIND="127.0.0.1"
SMTP_PORT="2525"
SMTP_AUTH_USER=""
SMTP_AUTH_PASS=""
SMTP_OUTBOUND_HOST=""
SMTP_OUTBOUND_PORT="587"
SMTP_OUTBOUND_SECURE="false"
SMTP_OUTBOUND_USER=""
SMTP_OUTBOUND_PASS=""

RETENTION_DAYS="30"
