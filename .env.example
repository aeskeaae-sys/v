# RELAYBOX_ENCRYPTION_KEY: 32+ char secret for AES-256-GCM encryption of mailbox credentials and webhook secrets.
# Generate with: openssl rand -hex 32
RELAYBOX_ENCRYPTION_KEY=

# REQUIRE_API_KEY: Set to "true" to enforce API key/session auth on all /api/v1 endpoints.
REQUIRE_API_KEY=false

# PORT: HTTP server port (default 3000).
PORT=3000

# NODE_ENV: Set to "production" to enable production server behavior.
NODE_ENV=

# DISABLE_HMR: Set to "true" to disable Vite HMR and file watching.
DISABLE_HMR=false

# WEBHOOK_INBOUND_SECRET: Optional HMAC-SHA256 secret to verify X-RelayBox-Signature on POST /api/v1/inbound.
WEBHOOK_INBOUND_SECRET=

# SMTP_PORT: Local inbound ESMTP listener port (default 2525).
SMTP_PORT=2525
SMTP_AUTH_USER=
SMTP_AUTH_PASS=

# Optional Outbound SMTP Relay configuration
SMTP_OUTBOUND_HOST=
SMTP_OUTBOUND_PORT=587
SMTP_OUTBOUND_SECURE=false
SMTP_OUTBOUND_USER=
SMTP_OUTBOUND_PASS=

# RETENTION_DAYS: Automatic retention period for messages, deliveries, and logs (default 30 days).
RETENTION_DAYS=30

# RELAYBOX_BOOTSTRAP_SECRET: Required to create UI sessions when REQUIRE_API_KEY=true.
# Generate with: openssl rand -hex 24
RELAYBOX_BOOTSTRAP_SECRET=
